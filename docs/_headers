# Cloudflare Pages headers: the same cache rules as vercel.json.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
