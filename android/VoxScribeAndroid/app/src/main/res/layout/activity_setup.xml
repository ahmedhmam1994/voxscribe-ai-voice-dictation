<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vox_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <View
            android:id="@+id/brand_mark"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_brand_mark" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/vox_on_surface"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_subtitle"
            android:textColor="@color/vox_on_surface_muted"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_card"
            android:padding="16dp"
            android:textColor="@color/vox_on_surface"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grant_perm_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_step1"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/vox_primary"
            android:textColor="@color/vox_on_primary"
            app:iconTint="@color/vox_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enable_keyboard_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_step2"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:icon="@drawable/ic_keyboard_switch"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/vox_surface_container_high"
            android:textColor="@color/vox_on_surface"
            app:iconTint="@color/vox_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pick_keyboard_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/setup_step3"
            android:textAllCaps="false"
            android:textSize="15sp"
            app:icon="@drawable/ic_keyboard_switch"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/vox_surface_container_high"
            android:textColor="@color/vox_on_surface"
            app:iconTint="@color/vox_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_settings_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/settings_title"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/vox_on_surface_muted"
            android:textColor="@color/vox_on_surface_muted" />

    </LinearLayout>
</ScrollView>
