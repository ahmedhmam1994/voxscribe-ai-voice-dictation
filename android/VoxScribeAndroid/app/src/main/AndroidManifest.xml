<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lets us check whether an offline recognizer language pack is installed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Floating-bubble mode (alternative to switching keyboards, see
         VoxScribeAccessibilityService): draws the bubble above other apps.
         Special permission: not grantable via a normal runtime dialog,
         the user must enable it via Settings.ACTION_MANAGE_OVERLAY_PERMISSION. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Needed on Android 13+ to actually show BubbleService's persistent
         foreground-service notification (a runtime prompt, requested in
         Phase 5's onboarding, not here). The foreground service itself
         still starts and runs without it either way: this permission
         only controls whether the notification is visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required alongside foregroundServiceType="microphone" below, since
         without it Android/MIUI's background-mic restriction silently
         zeroes out AudioRecord's captured audio for a service that isn't a
         visible foreground Activity, even though RECORD_AUDIO is granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:name=".VoxScribeApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.VoxScribe">

        <!-- Small launcher activity: lets the user open the app to grant the
             mic permission and jump to system settings to enable the keyboard.
             VoxScribe otherwise has no "main window" - same spirit as the
             desktop app, which is tray-first with no required main window. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent helper activity used only to pop the RECORD_AUDIO
             runtime permission dialog. A Service (which is what the IME is)
             cannot request runtime permissions directly, so the IME launches
             this, it asks, and finishes itself. -->
        <activity
            android:name=".PermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Settings/diagnostics screen, reachable from the keyboard's gear
             icon and from the setup screen. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- The actual keyboard / input method. -->
        <service
            android:name=".VoxScribeInputMethodService"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Floating-bubble mode: an alternative to switching keyboards.
             Detects the focused text field system-wide and inserts
             dictated text into it directly, the same approach Wispr Flow
             uses on Android. Requires BIND_ACCESSIBILITY_SERVICE (a system
             permission only the OS can grant to a declared service) plus
             the user separately enabling it in Settings > Accessibility:
             there is no runtime-dialog path for this, unlike RECORD_AUDIO. -->
        <service
            android:name=".VoxScribeAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The floating bubble itself: a WindowManager overlay + a
             foreground service (required by Android 8+ for any
             long-running background work, here specifically to keep the
             overlay window alive). foregroundServiceType="specialUse" is
             the only category that fits a floating-dictation-button use
             case; Android 14+ requires both this and the PROPERTY_SPECIAL_USE_FGS_SUBTYPE
             below to explain why in the Play Store review. -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating dictation bubble: an alternative to switching keyboards, lets the user hold the bubble to record and dictate into the focused field." />
        </service>

    </application>
</manifest>
