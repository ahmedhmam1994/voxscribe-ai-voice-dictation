<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: nothing is copied to Google's cloud backup or to a
     new phone during setup. History, word lists, settings and the Pro key stay
     on this phone only (see docs/privacy-at-a-glance.html). Older versions are
     covered by allowBackup="false" in the manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
