<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for VoxScribeAccessibilityService (floating-button mode).

  canRetrieveWindowContent and the event types below are the minimum needed to
  know which text box is focused (typeViewFocused), to drop that reference when
  the app or window changes (typeWindowStateChanged), and to show the bubble
  only while a text box is being edited with the keyboard open
  (typeWindowContentChanged, typeWindowsChanged and flagRetrieveInteractiveWindows,
  used only to see whether the keyboard window is present). Beyond that, the screen
  is read only while dictating: its words fix how names are spelled (ScreenWords,
  can be turned off), its box labels let one sentence fill a form (FormFill), and
  "send it" searches for a button labelled Send. typeViewTextChanged is only acted
  on for the box VoxScribe just typed into, so a spelling fix the person makes
  there can be learned (LearnedWords, can be turned off). Nothing read is kept or
  sent, apart from a learned fix itself, which stays on the phone.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:icon="@mipmap/ic_launcher"
    android:notificationTimeout="150"
    android:settingsActivity="com.voxscribe.android.MainActivity" />
