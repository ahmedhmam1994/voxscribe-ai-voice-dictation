<?xml version="1.0" encoding="utf-8"?>
<!--
  Config for VoxScribeAccessibilityService (floating-button mode).

  canRetrieveWindowContent and the event types below are the minimum needed to
  know which text box is focused (typeViewFocused), to drop that reference when
  the app or window changes (typeWindowStateChanged), and to show the bubble
  only while a text box is being edited with the keyboard open
  (typeWindowContentChanged, typeWindowsChanged and flagRetrieveInteractiveWindows,
  used only to see whether the keyboard window is present). Nothing on screen is
  read beyond that.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:icon="@mipmap/ic_launcher"
    android:notificationTimeout="150"
    android:settingsActivity="com.voxscribe.android.MainActivity" />
