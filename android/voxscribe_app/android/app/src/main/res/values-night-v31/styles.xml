<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and newer draw their own splash screen and ignore the plain
         window background, which showed a black frame before the intro. Give it
         the app's dark color and the four bar mark so the launch flows into the
         animated intro. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/vox_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
