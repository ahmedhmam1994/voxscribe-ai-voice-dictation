# Copy to keystore.properties (untracked) and fill in real values after
# generating a release keystore, e.g.:
#
#   keytool -genkeypair -v -keystore release.keystore -alias voxscribe \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.keystore and this filled-in file OUT of git -- losing them
# means losing the ability to publish updates to the same Play Store
# listing, so back them up somewhere safe (password manager / secure
# storage), separately from this repo.

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=voxscribe
keyPassword=CHANGE_ME
